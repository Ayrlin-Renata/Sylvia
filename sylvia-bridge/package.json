{
	"name": "sylvia-bridge",
	"version": "0.1.0",
	"description": "DeepSeek Harness plugin: network-aware harness gating (metered pause/resume context) plus the mobile client half (base mobile stylesheet, settings tabs-accordion, sidebar drawer).",
	"license": "MIT",
	"type": "module",
	"main": "./lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md"
	],
	"keywords": [
		"deepseek",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"cordis",
		"sylvia",
		"network-gate"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": []
		}
	},
	"scripts": {
		"test": "node --test \"test/*.test.mjs\""
	},
	"engines": {
		"node": ">=22.19"
	}
}
